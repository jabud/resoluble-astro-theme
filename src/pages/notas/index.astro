---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../site.config';

const fmt = (d: Date) =>
  d.toLocaleDateString(site.locale, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

const posts = (await getCollection('notas', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Notas" description={`Notas técnicas e ideas de ${site.shortAuthor}.`}>
  <h1>Notas</h1>
  <p class="muted">Notas técnicas e ideas.</p>

  <ul class="entry-list">
    {
      posts.map((post) => (
        <li class="entry">
          <p class="entry-title">
            <a href={`/notas/${post.id}/`} class="stretched-link">{post.data.title}</a>
          </p>
          <p class="entry-meta">
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          </p>
          <p class="entry-desc">{post.data.description}</p>
        </li>
      ))
    }
    {posts.length === 0 && <li class="muted">Pronto habrá contenido aquí.</li>}
  </ul>
</BaseLayout>
