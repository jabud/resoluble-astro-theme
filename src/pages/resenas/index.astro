---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../site.config';

const fmt = (d: Date) =>
  d.toLocaleDateString(site.locale, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

const resenas = (await getCollection('resenas', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Reseñas" description={`Reseñas de libros de ${site.shortAuthor}.`}>
  <h1>Reseñas</h1>
  <p class="muted">Libros que he leído y lo que me dejaron.</p>

  <ul class="entry-list">
    {
      resenas.map((r) => (
        <li class="entry">
          <p class="entry-title">
            <a href={`/resenas/${r.id}/`} class="stretched-link">{r.data.title}</a>
          </p>
          <p class="entry-meta">
            <time datetime={r.data.pubDate.toISOString()}>{fmt(r.data.pubDate)}</time>
            {r.data.author && <span> · {r.data.author}</span>}
          </p>
          <p class="entry-desc">{r.data.description}</p>
        </li>
      ))
    }
    {resenas.length === 0 && <li class="muted">Pronto habrá reseñas aquí.</li>}
  </ul>
</BaseLayout>
