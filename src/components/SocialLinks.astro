---
// Enlaces sociales reutilizables (iconos SVG inline, sin dependencias externas).
// La lista se edita en src/site.config.ts.
import { socials as links } from '../site.config';
---

<div class="socials">
  {
    links.map((s) => (
      <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name} title={s.name}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={s.path} />
        </svg>
      </a>
    ))
  }
</div>
