---
// Menú lateral colapsable. Items con icono + etiqueta; al colapsar (<<)
// quedan solo los iconos. La preferencia se guarda en localStorage
// (la init anti-parpadeo vive en el <head> de BaseLayout).
// La lista de items se edita en src/site.config.ts.
import { nav as items } from '../site.config';

const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---

<aside class="sidebar">
  <ul class="nav-menu">
    {
      items.map((item) => (
        <li class="nav-item">
          <a
            href={item.href}
            title={item.label}
            {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            aria-current={!item.external && isActive(item.href) ? 'page' : undefined}
          >
            <svg
              class="icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={item.icon}
            />
            <span class="label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <button id="sidebar-toggle" class="collapse-btn" type="button" aria-label="Colapsar menú">
    <span class="collapse-chevron" aria-hidden="true"></span>
    <span class="collapse-label">colapsar</span>
  </button>
</aside>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('sidebar-toggle');
  btn?.addEventListener('click', () => {
    const collapsed = root.dataset.sidebar === 'collapsed';
    if (collapsed) {
      delete root.dataset.sidebar;
      try {
        localStorage.setItem('sidebar', 'expanded');
      } catch (e) {}
    } else {
      root.dataset.sidebar = 'collapsed';
      try {
        localStorage.setItem('sidebar', 'collapsed');
      } catch (e) {}
    }
  });
</script>
